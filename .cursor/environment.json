{
  "name": "Gestão Financeira Familiar",
  "user": "ubuntu",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "laravel-server",
      "command": "php artisan serve --host=0.0.0.0 --port=8000"
    },
    {
      "name": "vite",
      "command": "npm run dev -- --host 0.0.0.0"
    }
  ],
  "ports": [8000, 5173]
}
